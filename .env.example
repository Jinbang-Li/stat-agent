# ---------------------------------------------------------------------------
# 复制成 .env 后填写（.env 已被 .gitignore 排除，不会被提交）
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 优先级：真实环境变量 > .env。也就是说，Docker/K8s 里注入的同名变量
# 不会被这个文件覆盖，仓库里的 .env 只服务于本地开发。
# ---------------------------------------------------------------------------

# DeepSeek API Key。留空 = 离线模式（意图走关键词、SQL 走模板、报告走模板，
# 整条链路照常跑完，只是不调模型）。
DEEPSEEK_API_KEY=

# 接口地址。官方是 https://api.deepseek.com；
# 换代理 / 换自建网关时改这里（不要带结尾斜杠）。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名
DEEPSEEK_MODEL=deepseek-chat

# 温度。0 = 每次输出完全一致（跑回归、录演示时用）；
# 0.1 = 措辞略有变化。注意温度不是幻觉控制手段，详见 README。
STAT_AGENT_TEMPERATURE=0.1
